Процедура ОбработкаПроведения(Отказ, Режим)

    // Разрешаем запись движений
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ПродажиОборотный.Записывать = Истина;
    Движения.ПартииТоваров.Записывать = Истина;

    // 1. Обычные движения по Остаткам и Продажам
    Для Каждого СтрокаТЧ Из Товары Цикл
        
        // Остатки
        ДвижениеОстатки = Движения.ОстаткиТоваров.Добавить();
        ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
        ДвижениеОстатки.Период = Дата;
        ДвижениеОстатки.Товар = СтрокаТЧ.Товар;
        ДвижениеОстатки.Количество = СтрокаТЧ.Количество;
        
        // Продажи (Обороты)
        ДвижениеПродажи = Движения.ПродажиОборотный.Добавить();
        ДвижениеПродажи.Период = Дата;
        ДвижениеПродажи.Товар = СтрокаТЧ.Товар;
        ДвижениеПродажи.Контрагент = Контрагент;
        ДвижениеПродажи.Количество = СтрокаТЧ.Количество;
        ДвижениеПродажи.Сумма = СтрокаТЧ.Сумма;
        
    КонецЦикла;

    // 2. Списание по FIFO
    Для Каждого СтрокаТЧ Из Товары Цикл
        
        КолвоНужноСписать = СтрокаТЧ.Количество;
        
        // Получаем остатки партий для конкретного товара, сортируя по дате поступления
        Запрос = Новый Запрос;
        Запрос.Текст = 
            "ВЫБРАТЬ
            |	ПартииТоваровОстатки.Партия КАК Партия,
            |	ПартииТоваровОстатки.КоличествоОстаток КАК Остаток
            |ИЗ
            |	РегистрНакопления.ПартииТоваров.Остатки(&Момент, Товар = &Товар) КАК ПартииТоваровОстатки
            |УПОРЯДОЧИТЬ ПО
            |	Партия.Дата";
        
        Запрос.УстановитьПараметр("Момент", МоментВремени());
        Запрос.УстановитьПараметр("Товар", СтрокаТЧ.Товар);
        
        Выборка = Запрос.Выполнить().Выбрать();
        
        Пока Выборка.Следующий() И КолвоНужноСписать > 0 Цикл
            
            Если Выборка.Остаток >= КолвоНужноСписать Тогда
                КолвоСписать = КолвоНужноСписать;
            Иначе
                КолвоСписать = Выборка.Остаток;
            КонецЕсли;
            
            // Записываем расход по партии
            ДвижениеПартии = Движения.ПартииТоваров.Добавить();
            ДвижениеПартии.ВидДвижения = ВидДвиженияНакопления.Расход;
            ДвижениеПартии.Период = Дата;
            ДвижениеПартии.Товар = СтрокаТЧ.Товар;
            ДвижениеПартии.Партия = Выборка.Партия;
            ДвижениеПартии.Количество = КолвоСписать;
            
            КолвоНужноСписать = КолвоНужноСписать - КолвоСписать;
            
        КонецЦикла;
        
    КонецЦикла;

КонецПроцедуры